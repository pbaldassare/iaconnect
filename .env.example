# IA Connect — environment variables.
# Copy to `.env` (worker, scripts) and to `apps/web/.env.local` (web app). Never commit real values.
# One name per variable; every variable read by the code is listed here (apps/web/test/env.test.ts checks it).
# "Read by" says which process needs it: web = Next.js server, worker = apps/worker,
# edge = supabase/functions/webhook, connectors = packages/connectors (run inside web, worker and edge).

# ── Supabase (schema `ia_connect`; the project is named in docs/decisioni) ──

# Read by web (browser and server): the project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Read by web (browser and server): the public anon key. Safe in the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Read by web (server only: Vault secrets, invitations, AI usage) and by edge. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Read by edge only. Supabase sets it by itself for deployed functions; needed only to serve them locally.
SUPABASE_URL=
# Read by worker (required): direct Postgres connection string of the project, service role.
DATABASE_URL=
# Read by worker: "false" for a local database without TLS. Default: TLS on.
DATABASE_SSL=
# Read by worker: "true" to verify the database certificate. Default: not verified.
DATABASE_SSL_VERIFY=
# Read by worker: size of the Postgres connection pool. Default 10.
DATABASE_POOL_SIZE=

# ── Web app ──

# Read by web: public address of the app, used in mail links and as OAuth return address.
# Required in production (the request's Host header is never trusted there).
APP_URL=http://localhost:3000
# Read by web: key that signs the OAuth state cookie. Required for OAuth connections (Google,
# Microsoft, Facebook): a random string of at least 32 characters, e.g. `openssl rand -hex 32`.
OAUTH_STATE_SECRET=

# ── AI ──

# Read by web (flow assistant) and worker (ai.* blocks, scrape tracing). Without it those features say so and stop.
ANTHROPIC_API_KEY=
# Read by web and worker (packages/ai): model of the capable tier. Optional: default in packages/ai/src/models.ts.
AI_MODEL_SMART=
# Read by worker (packages/ai): model of the fast tier. Optional: default in packages/ai/src/models.ts.
AI_MODEL_FAST=
# Read by web and worker (packages/ai): "0" disables the server-side model fallback. Optional.
AI_SERVER_FALLBACK=

# ── Connectors: platform-level OAuth apps and provider settings ──
# Handed to connector code by web, worker and edge. The worker passes every variable whose
# name starts with GOOGLE_, MICROSOFT_, META_, WAWEBAPI_ or WEBHOOK_, and nothing else.

# Read by connectors (Gmail, Google Calendar): OAuth client id.
GOOGLE_CLIENT_ID=
# Read by connectors (Gmail, Google Calendar): OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Read by connectors (Microsoft 365): OAuth client id.
MICROSOFT_CLIENT_ID=
# Read by connectors (Microsoft 365): OAuth client secret.
MICROSOFT_CLIENT_SECRET=
# Read by connectors (Facebook, Instagram): Meta app id.
META_APP_ID=
# Read by connectors (Facebook, Instagram, WhatsApp webhooks): Meta app secret, also verifies webhook signatures.
META_APP_SECRET=
# Read by connectors on edge: token Meta sends back when the webhook address is registered.
META_WEBHOOK_VERIFY_TOKEN=
# Read by connectors: Graph API version, e.g. v21.0. Optional: default in packages/connectors/src/lib/meta.ts.
META_GRAPH_VERSION=
# Read by connectors (WhatsApp via QR): base URL of the waWebApi service.
WAWEBAPI_BASE_URL=
# Read by web and edge: public base address of the webhook function, when it is not
# <project URL>/functions/v1/webhook (custom domain or proxy). Optional.
WEBHOOK_PUBLIC_URL=

# ── Worker ──

# Read by worker: events and jobs handled in parallel. Default 4.
WORKER_CONCURRENCY=4
# Read by worker: deliveries of an event or job before it is marked failed. Default 5.
WORKER_MAX_ATTEMPTS=
# Read by worker, non-production only: every outbound message goes to this recipient instead of the
# contact (a phone and/or a mail address, comma separated); channels without one are blocked.
OUTBOUND_OVERRIDE_RECIPIENT=
# Read by worker, non-production only: phone that receives every WhatsApp message; other channels are not blocked.
WHATSAPP_TEST_RECIPIENT=
