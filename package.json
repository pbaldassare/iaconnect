{
  "name": "ia-connect",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "gen:seed": "tsx scripts/gen-seed.ts",
    "gen:types": "tsx scripts/gen-types.ts",
    "build": "node scripts/build-site.mjs",
    "build:app": "npm run cf:build -w @ia-connect/web",
    "deploy:app": "wrangler deploy --config apps/web/wrangler.jsonc"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
